{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "go",
      "description": "Update toolbox tools in .toolbox.mk",
      "managerFilePatterns": [
        ".toolbox.mk"
      ],
      "matchStrings": [
        "# renovate: packageName=(?<packageName>.+?)\\s+.+?_VERSION \\?= (?<currentValue>.+?)\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/modern-go/reflect2"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "github.com/crossplane/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "crossplane"
    },
    {
      "description": "Go directive: bump the go line in go.mod and separate minor and patch updates so each gets its own policy",
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "separateMinorPatch": true
    },
    {
      "description": "Go directive: move to a new Go minor only once it is the oldest supported (~6 months after release)",
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "180 days",
      "internalChecksFilter": "strict"
    }
  ]
}
